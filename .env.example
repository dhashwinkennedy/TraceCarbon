# ==============================================================================
# TRACECARBON — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to '.env' and populate with your local/cloud configuration values.
# NEVER commit real credentials, secrets, API keys, or connection strings to Git.

# Application Information
APP_NAME=TraceCarbon
APP_ENV=development
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Database Persistence (MongoDB Atlas or Local MongoDB)
# Example Local: mongodb://127.0.0.1:27017
# Example Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=scope3track_final_qa

# Authentication & Cryptographic Security
# Generate a secure 32+ character key: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your_jwt_secret_key_minimum_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# OpenRouter AI Integration (NVIDIA Nemotron 3 Ultra)
# Base URL: https://openrouter.ai/api/v1
# Model: nvidia/nemotron-3-ultra-550b-a55b:free (or nvidia/nemotron-3-ultra-550b-a55b)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_TIMEOUT=120

# CORS & Frontend Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# File Storage & Upload Security
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
ALLOWED_UPLOAD_EXTENSIONS=.xlsx,.csv,.pdf,.png,.jpg,.jpeg

# Logging
LOG_LEVEL=INFO
